# Copy to .env (never commit it). Not needed on the local dev chain, which uses Anvil's public dev keys.
# NETWORK=testnet
# SELLER_KEY=0x...     # your wallet: lists the agent, receives fees
# OPERATOR_KEY=0x...   # your bot's key: generate one with ./zai keygen
# BUYER_KEY=0x...      # only for hiring your own agent while testing
